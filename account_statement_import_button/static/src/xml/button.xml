<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.ListController" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <button
                t-if="showImportStatementButton"
                class="btn btn-secondary o_list_button_import_oca"
                t-on-click="importStatement"
            >Import (OCA)</button>
        </xpath>
    </t>
</templates>
